<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mi Liceo</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        body {
            background: #f7f9fc;
            color: #334155;
        }

        /* ================= HEADER ================= */

        header {
            height: 75px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
            border-bottom: 1px solid #e5e7eb;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 21px;
            font-weight: bold;
            color: #4f6f8f;
        }

        .logo-icon {
            width: 42px;
            height: 42px;
            background: #cde8f6;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .header-buttons {
            display: flex;
            gap: 10px;
        }

        .header-btn {
            border: none;
            background: #f1f5f9;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 19px;
            transition: 0.2s;
        }

        .header-btn:hover {
            background: #dcecf5;
            transform: translateY(-2px);
        }

        /* ================= CONTENIDO ================= */

        main {
            max-width: 1250px;
            margin: auto;
            padding: 35px;
        }

        .welcome {
            margin-bottom: 30px;
        }

        .welcome h1 {
            font-size: 32px;
            color: #334e68;
            margin-bottom: 8px;
        }

        .welcome p {
            color: #718096;
        }

        /* ================= BOTONES ================= */

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 30px;
        }

        .action {
            border: none;
            background: white;
            padding: 22px;
            border-radius: 18px;
            cursor: pointer;
            text-align: left;
            box-shadow: 0 5px 20px rgba(50, 70, 90, 0.06);
            transition: 0.25s;
        }

        .action:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(50, 70, 90, 0.10);
        }

        .action-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            font-size: 22px;
            margin-bottom: 14px;
        }

        .blue {
            background: #dff3fc;
        }

        .pink {
            background: #f8dfe7;
        }

        .purple {
            background: #e8def8;
        }

        .green {
            background: #dff3e8;
        }

        .action h3 {
            font-size: 16px;
            margin-bottom: 5px;
            color: #334e68;
        }

        .action p {
            font-size: 13px;
            color: #8492a6;
        }

        /* ================= MAPA ================= */

        .content-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 25px;
        }

        .card {
            background: white;
            border-radius: 22px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(50, 70, 90, 0.06);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .card-header h2 {
            color: #334e68;
            font-size: 21px;
        }

        .view-map {
            border: none;
            background: #e3f2fa;
            color: #47758f;
            padding: 9px 14px;
            border-radius: 10px;
            cursor: pointer;
        }

        /* MAPA VISUAL */

        .map {
            height: 420px;
            background: #eef6ef;
            border-radius: 18px;
            position: relative;
            overflow: hidden;
            border: 2px solid #e2eee5;
        }

        .path {
            position: absolute;
            background: #ffffff;
            border-radius: 20px;
        }

        .path-one {
            width: 90%;
            height: 25px;
            top: 48%;
            left: 5%;
        }

        .path-two {
            height: 90%;
            width: 25px;
            left: 48%;
            top: 5%;
        }

        .building {
            position: absolute;
            background: #d9ebf4;
            border: 2px solid #b9d8e7;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            color: #476b7d;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .building:hover {
            transform: scale(1.05);
            background: #c9e5f2;
        }

        .b1 {
            width: 140px;
            height: 85px;
            top: 30px;
            left: 30px;
        }

        .b2 {
            width: 140px;
            height: 85px;
            top: 30px;
            right: 30px;
        }

        .b3 {
            width: 140px;
            height: 85px;
            bottom: 30px;
            left: 30px;
        }

        .b4 {
            width: 140px;
            height: 85px;
            bottom: 30px;
            right: 30px;
        }

        .b5 {
            width: 130px;
            height: 70px;
            top: 175px;
            left: 50%;
            transform: translateX(-50%);
            background: #dff3e8;
            border-color: #b8dfc8;
        }

        .b5:hover {
            transform: translateX(-50%) scale(1.05);
        }

        /* ================= INFORMACIÓN ================= */

        .info-box {
            background: #f8fafc;
            padding: 17px;
            border-radius: 15px;
            margin-bottom: 12px;
        }

        .info-box strong {
            display: block;
            color: #475569;
            margin-bottom: 5px;
        }

        .info-box span {
            color: #8996a8;
            font-size: 14px;
        }

        .notice {
            background: #fff4e5;
            border-left: 4px solid #f4c27a;
        }

        /* ================= FOOTER ================= */

        footer {
            text-align: center;
            padding: 30px;
            color: #94a3b8;
            font-size: 13px;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 850px) {

            header {
                padding: 0 18px;
            }

            main {
                padding: 25px 18px;
            }

            .quick-actions {
                grid-template-columns: repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 500px) {

            .welcome h1 {
                font-size: 25px;
            }

            .quick-actions {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .action {
                padding: 15px;
            }

            .action p {
                display: none;
            }

            .map {
                height: 350px;
            }

            .building {
                transform: scale(0.8);
            }
        }
    </style>
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header>

        <div class="logo">
            <div class="logo-icon">🏫</div>
            <span>Mi Liceo</span>
        </div>

        <div class="header-buttons">
            <button class="header-btn" onclick="mostrarMensaje('Tienes 3 notificaciones 🔔')">
                🔔
            </button>

            <button class="header-btn" onclick="mostrarMensaje('Ajustes de la aplicación ⚙️')">
                ⚙️
            </button>

            <button class="header-btn" onclick="mostrarMensaje('Perfil del estudiante 👤')">
                👤
            </button>
        </div>

    </header>


    <!-- ================= CONTENIDO ================= -->

    <main>

        <section class="welcome">
            <h1>¡Bienvenido a Mi Liceo! 👋</h1>
            <p>Encuentra tus salas, información y servicios del establecimiento.</p>
        </section>


        <!-- BOTONES PRINCIPALES -->

        <section class="quick-actions">

            <button class="action" onclick="mostrarMensaje('Buscando salas...')">

                <div class="action-icon blue">📚</div>

                <h3>Salas</h3>
                <p>Encuentra tu sala de clases</p>

            </button>


            <button class="action" onclick="mostrarMensaje('Abriendo biblioteca...')">

                <div class="action-icon purple">📖</div>

                <h3>Biblioteca</h3>
                <p>Información y horarios</p>

            </button>


            <button class="action" onclick="mostrarMensaje('Mostrando horarios...')">

                <div class="action-icon pink">🕐</div>

                <h3>Horarios</h3>
                <p>Revisa tus clases</p>

            </button>


            <button class="action" onclick="mostrarMensaje('Mostrando información del liceo...')">

                <div class="action-icon green">ℹ️</div>

                <h3>Información</h3>
                <p>Datos del establecimiento</p>

            </button>

        </section>


        <!-- MAPA + INFORMACIÓN -->

        <section class="content-grid">


            <!-- MAPA -->

            <div class="card">

                <div class="card-header">

                    <h2>🗺️ Mapa del Liceo</h2>

                    <button class="view-map"
                        onclick="mostrarMensaje('Mapa ampliado próximamente 🗺️')">
                        Ver mapa
                    </button>

                </div>


                <div class="map">

                    <div class="path path-one"></div>
                    <div class="path path-two"></div>


                    <div class="building b1"
                        onclick="mostrarMensaje('Edificio A - Salas de clases')">
                        🏫<br>
                        Edificio A
                    </div>


                    <div class="building b2"
                        onclick="mostrarMensaje('Edificio B - Salas de clases')">
                        🏫<br>
                        Edificio B
                    </div>


                    <div class="building b3"
                        onclick="mostrarMensaje('Biblioteca del liceo')">
                        📖<br>
                        Biblioteca
                    </div>


                    <div class="building b4"
                        onclick="mostrarMensaje('Gimnasio')">
                        🏀<br>
                        Gimnasio
                    </div>


                    <div class="building b5"
                        onclick="mostrarMensaje('Entrada principal')">
                        🚪<br>
                        Entrada
                    </div>

                </div>

            </div>


            <!-- INFORMACIÓN -->

            <div class="card">

                <div class="card-header">
                    <h2>📌 Información</h2>
                </div>


                <div class="info-box">

                    <strong>📅 Próxima actividad</strong>

                    <span>
                        Reunión de estudiantes
                        <br>
                        Viernes · 10:00
                    </span>

                </div>


                <div class="info-box">

                    <strong>🍽️ Comedor</strong>

                    <span>
                        Almuerzo disponible
                        <br>
                        12:30 - 14:00
                    </span>

                </div>


                <div class="info-box">

                    <strong>📚 Biblioteca</strong>

                    <span>
                        Abierta actualmente
                        <br>
                        08:00 - 17:30
                    </span>

                </div>


                <div class="info-box notice">

                    <strong>⚠️ Aviso</strong>

                    <span>
                        Recuerda revisar tus horarios
                        antes de comenzar las clases.
                    </span>

                </div>

            </div>

        </section>

    </main>


    <footer>
        Mi Liceo · Plataforma estudiantil © 2026
    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        function mostrarMensaje(mensaje) {

            alert(mensaje);

        }

    </script>

</body>
</html>
