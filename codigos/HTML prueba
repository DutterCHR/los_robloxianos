<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OpenEduca</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f6f5;
            color: #26383a;
            transition: 0.3s;
        }

        button {
            font-family: inherit;
        }


        /* =========================
           BARRA SUPERIOR
        ========================= */

        header {
            height: 68px;
            background: #234b4d;
            color: white;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 30px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;

            background: #dce9e3;
            color: #234b4d;

            border-radius: 8px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 20px;
        }

        .logo h2 {
            font-size: 19px;
            font-weight: 600;
        }


        /* =========================
           BOTONES DEL HEADER
        ========================= */

        .header-buttons {
            display: flex;
            gap: 5px;
        }

        .header-button {
            width: 40px;
            height: 40px;

            border: none;
            border-radius: 7px;

            background: transparent;
            color: white;

            font-size: 18px;

            cursor: pointer;
        }

        .header-button:hover {
            background: #315d5f;
        }


        /* =========================
           CONTENIDO
        ========================= */

        main {
            max-width: 1200px;
            margin: auto;

            padding: 35px 25px;
        }

        .bienvenida {
            margin-bottom: 25px;
        }

        .bienvenida h1 {
            color: #234b4d;
            font-size: 28px;
            margin-bottom: 7px;
        }

        .bienvenida p {
            color: #718080;
            font-size: 14px;
        }


        /* =========================
           MENÚ PRINCIPAL
        ========================= */

        .menu {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 14px;

            margin-bottom: 22px;
        }

        .menu-button {
            background: white;

            border: 1px solid #dfe6e3;

            border-radius: 9px;

            padding: 18px;

            text-align: left;

            cursor: pointer;

            transition: 0.2s;
        }

        .menu-button:hover {
            border-color: #94b5a7;
            transform: translateY(-2px);
        }

        .menu-icon {
            width: 38px;
            height: 38px;

            background: #e4eee9;

            border-radius: 8px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 12px;

            font-size: 18px;
        }

        .menu-button h3 {
            color: #294e50;
            font-size: 15px;

            margin-bottom: 5px;
        }

        .menu-button p {
            color: #7a8785;
            font-size: 12px;
        }


        /* =========================
           CONTENIDO PRINCIPAL
        ========================= */

        .contenedor {
            display: grid;

            grid-template-columns: 2fr 1fr;

            gap: 20px;
        }

        .tarjeta {
            background: white;

            border: 1px solid #dfe6e3;

            border-radius: 11px;

            padding: 20px;
        }

        .tarjeta h2 {
            color: #294e50;

            font-size: 19px;

            margin-bottom: 15px;
        }


        /* =========================
           MAPA
        ========================= */

        .mapa-superior {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 15px;
        }

        .mapa-superior h2 {
            margin-bottom: 0;
        }

        .abrir-maps {
            text-decoration: none;

            color: #315f60;

            font-size: 13px;

            border: 1px solid #cbdad4;

            padding: 7px 10px;

            border-radius: 6px;
        }

        .abrir-maps:hover {
            background: #edf4f1;
        }

        .mapa {
            width: 100%;
            height: 400px;

            border-radius: 9px;

            overflow: hidden;

            border: 1px solid #d8dfdc;
        }

        .mapa iframe {
            width: 100%;
            height: 100%;

            border: 0;
        }


        /* =========================
           INFORMACIÓN
        ========================= */

        .dato {
            padding: 13px 0;

            border-bottom: 1px solid #e8ecea;
        }

        .dato:last-child {
            border-bottom: none;
        }

        .dato strong {
            display: block;

            color: #315657;

            font-size: 14px;

            margin-bottom: 5px;
        }

        .dato span {
            color: #788583;

            font-size: 13px;

            line-height: 1.5;
        }


        /* =========================
           PANELES
        ========================= */

        .panel {
            position: fixed;

            top: 68px;
            right: 25px;

            width: 290px;

            background: white;

            border: 1px solid #dce3e0;

            border-radius: 9px;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.12);

            padding: 20px;

            display: none;

            z-index: 100;
        }

        .panel.mostrar {
            display: block;
        }

        .panel h3 {
            color: #294e50;

            margin-bottom: 15px;
        }

        .panel-opcion {
            display: flex;

            justify-content: space-between;

            align-items: center;

            padding: 12px 0;

            border-bottom: 1px solid #edf0ef;

            font-size: 14px;
        }

        .panel-opcion:last-child {
            border-bottom: none;
        }


        /* =========================
           SWITCH
        ========================= */

        .switch {
            width: 40px;
            height: 21px;

            background: #cbd5d1;

            border-radius: 20px;

            cursor: pointer;

            position: relative;
        }

        .switch::after {
            content: "";

            position: absolute;

            width: 17px;
            height: 17px;

            top: 2px;
            left: 2px;

            background: white;

            border-radius: 50%;

            transition: 0.2s;
        }

        .switch.activo {
            background: #4f7d70;
        }

        .switch.activo::after {
            left: 21px;
        }


        /* =========================
           NOTIFICACIONES
        ========================= */

        .notificacion {
            background: #f1f5f3;

            padding: 11px;

            border-radius: 7px;

            margin-bottom: 8px;

            font-size: 13px;

            color: #526260;
        }


        /* =========================
           FOOTER
        ========================= */

        footer {
            text-align: center;

            padding: 25px;

            color: #87928f;

            font-size: 12px;
        }


        /* =========================
           MODO OSCURO
        ========================= */

        body.oscuro {
            background: #202b2c;
            color: #eeeeee;
        }

        body.oscuro .tarjeta,
        body.oscuro .menu-button,
        body.oscuro .panel {
            background: #2c393a;
            border-color: #415050;
        }

        body.oscuro .bienvenida h1,
        body.oscuro .tarjeta h2,
        body.oscuro .menu-button h3,
        body.oscuro .dato strong,
        body.oscuro .panel h3 {
            color: #dce9e3;
        }

        body.oscuro .bienvenida p,
        body.oscuro .menu-button p,
        body.oscuro .dato span {
            color: #b5c0be;
        }

        body.oscuro .menu-icon {
            background: #3b4b4b;
        }

        body.oscuro .notificacion {
            background: #354344;
            color: #c9d3d0;
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 850px) {

            .menu {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .contenedor {
                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 500px) {

            header {
                padding: 0 15px;
            }

            .logo h2 {
                font-size: 16px;
            }

            main {
                padding: 25px 15px;
            }

            .menu {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .menu-button {
                padding: 14px;
            }

            .menu-button p {
                display: none;
            }

            .mapa {
                height: 350px;
            }

            .panel {
                left: 15px;
                right: 15px;

                width: auto;
            }

        }

    </style>

</head>


<body>


    <!-- =================================
         CABECERA
    ================================== -->

    <header>

        <div class="logo">

            <div class="logo-icon">
                🎓
            </div>

            <h2>
                OpenEduca
            </h2>

        </div>


        <div class="header-buttons">


            <!-- NOTIFICACIONES -->

            <button
                class="header-button"
                onclick="abrirPanel('notificaciones')">

                🔔

            </button>


            <!-- AJUSTES -->

            <button
                class="header-button"
                onclick="abrirPanel('ajustes')">

                ⚙️

            </button>


            <!-- PERFIL -->

            <button
                class="header-button"
                onclick="abrirPanel('perfil')">

                👤

            </button>

        </div>

    </header>


    <!-- =================================
         PANEL AJUSTES
    ================================== -->

    <div
        id="ajustes"
        class="panel">

        <h3>
            Ajustes de OpenEduca
        </h3>


        <div class="panel-opcion">

            <span>
                Modo oscuro
            </span>

            <div
                id="switchOscuro"
                class="switch"
                onclick="modoOscuro()">
            </div>

        </div>


        <div class="panel-opcion">

            <span>
                Notificaciones
            </span>

            <div
                class="switch activo"
                onclick="this.classList.toggle('activo')">
            </div>

        </div>


        <div class="panel-opcion">

            <span>
                Sonidos
            </span>

            <div
                class="switch activo"
                onclick="this.classList.toggle('activo')">
            </div>

        </div>

    </div>


    <!-- =================================
         PANEL NOTIFICACIONES
    ================================== -->

    <div
        id="notificaciones"
        class="panel">

        <h3>
            Notificaciones
        </h3>


        <div class="notificacion">
            📢 Revisa los avisos del liceo.
        </div>


        <div class="notificacion">
            📚 Recuerda revisar tu horario.
        </div>


        <div class="notificacion">
            📝 Hay información nueva disponible.
        </div>

    </div>


    <!-- =================================
         PANEL PERFIL
    ================================== -->

    <div
        id="perfil"
        class="panel">

        <h3>
            Mi perfil
        </h3>


        <div class="panel-opcion">

            <span>
                Usuario
            </span>

            <strong>
                Estudiante
            </strong>

        </div>


        <div class="panel-opcion">

            <span>
                Curso
            </span>

            <strong>
                3° Medio
            </strong>

        </div>


        <div class="panel-opcion">

            <span>
                Estado
            </span>

            <strong>
                Activo
            </strong>

        </div>

    </div>


    <!-- =================================
         CONTENIDO PRINCIPAL
    ================================== -->

    <main>


        <section class="bienvenida">

            <h1>
                Bienvenido a OpenEduca
            </h1>

            <p>
                Plataforma de información y orientación
                para estudiantes del Liceo Antonio Varas de la Barra.
            </p>

        </section>


        <!-- =================================
             BOTONES
        ================================== -->

        <section class="menu">


            <!-- SALAS -->

            <button
                class="menu-button"
                onclick="mostrarSalas()">

                <div class="menu-icon">
                    🚪
                </div>

                <h3>
                    Salas
                </h3>

                <p>
                    Consulta las salas del establecimiento.
                </p>

            </button>


            <!-- HORARIOS -->

            <button
                class="menu-button"
                onclick="mostrarHorario()">

                <div class="menu-icon">
                    🕒
                </div>

                <h3>
                    Horarios
                </h3>

                <p>
                    Revisa tus horarios de clases.
                </p>

            </button>


            <!-- BIBLIOTECA -->

            <button
                class="menu-button"
                onclick="mostrarBiblioteca()">

                <div class="menu-icon">
                    📚
                </div>

                <h3>
                    Biblioteca
                </h3>

                <p>
                    Información y horarios.
                </p>

            </button>


            <!-- CONTACTO -->

            <button
                class="menu-button"
                onclick="mostrarContacto()">

                <div class="menu-icon">
                    ☎️
                </div>

                <h3>
                    Contacto
                </h3>

                <p>
                    Información del establecimiento.
                </p>

            </button>

        </section>


        <!-- =================================
             MAPA + INFORMACIÓN
        ================================== -->

        <section class="contenedor">


            <!-- =================================
                 MAPA GOOGLE MAPS
            ================================== -->

            <div class="tarjeta">

                <div class="mapa-superior">

                    <h2>
                        📍 Ubicación
                    </h2>


                    <a
                        class="abrir-maps"

                        href="https://www.google.com/maps/search/?api=1&query=Liceo+Antonio+Varas+de+la+Barra,+Avenida+Loa+2200,+Arica,+Chile"

                        target="_blank">

                        Abrir Maps ↗

                    </a>

                </div>


                <div class="mapa">

                    <iframe

                        src="https://www.google.com/maps?q=Liceo+Antonio+Varas+de+la+Barra,+Avenida+Loa+2200,+Arica,+Chile&output=embed"

                        loading="lazy"

                        allowfullscreen

                        referrerpolicy="no-referrer-when-downgrade">

                    </iframe>

                </div>

            </div>


            <!-- =================================
                 INFORMACIÓN DEL LICEO
            ================================== -->

            <div class="tarjeta">

                <h2>
                    Información
                </h2>


                <div class="dato">

                    <strong>
                        🏫 Establecimiento
                    </strong>

                    <span>
                        Liceo Antonio Varas
                        de la Barra
                    </span>

                </div>


                <div class="dato">

                    <strong>
                        📍 Dirección
                    </strong>

                    <span>
                        Avenida Loa #2200<br>
                        Arica, Chile
                    </span>

                </div>


                <div class="dato">

                    <strong>
                        🎓 Enseñanza
                    </strong>

                    <span>
                        Educación Media
                        Técnico Profesional
                    </span>

                </div>


                <div class="dato">

                    <strong>
                        💻 OpenEduca
                    </strong>

                    <span>
                        Plataforma digital
                        para estudiantes.
                    </span>

                </div>


                <div class="dato">

                    <strong>
                        🌐 Sitio del liceo
                    </strong>

                    <span>
                        liceoavb.cl
                    </span>

                </div>

            </div>

        </section>

    </main>


    <footer>

        OpenEduca · Proyecto escolar 2026

    </footer>


    <!-- =================================
         JAVASCRIPT
    ================================== -->

    <script>


        /* =========================
           ABRIR PANELES
        ========================= */

        function abrirPanel(id) {

            const panel =
                document.getElementById(id);

            const abierto =
                panel.classList.contains("mostrar");


            // Cerrar todos

            document
                .querySelectorAll(".panel")
                .forEach(function(p) {

                    p.classList.remove("mostrar");

                });


            // Abrir el seleccionado

            if (!abierto) {

                panel.classList.add("mostrar");

            }

        }


        /* =========================
           MODO OSCURO
        ========================= */

        function modoOscuro() {

            document.body
                .classList.toggle("oscuro");


            document
                .getElementById("switchOscuro")
                .classList.toggle("activo");

        }


        /* =========================
           SALAS
        ========================= */

        function mostrarSalas() {

            alert(
                "SALAS\n\n" +

                "Edificio A\n" +
                "Salas 101 - 105\n\n" +

                "Edificio B\n" +
                "Salas 201 - 205"
            );

        }


        /* =========================
           HORARIOS
        ========================= */

        function mostrarHorario() {

            alert(
                "HORARIO\n\n" +

                "08:00 - Matemática\n" +
                "09:30 - Lenguaje\n" +
                "11:00 - Ciencias\n" +
                "12:30 - Almuerzo"
            );

        }


        /* =========================
           BIBLIOTECA
        ========================= */

        function mostrarBiblioteca() {

            alert(
                "BIBLIOTECA\n\n" +

                "Horario de atención:\n" +

                "08:00 - 17:30"
            );

        }


        /* =========================
           CONTACTO
        ========================= */

        function mostrarContacto() {

            alert(
                "CONTACTO\n\n" +

                "Liceo Antonio Varas de la Barra\n\n" +

                "Av. Loa #2200\n" +

                "Arica, Chile"
            );

        }

    </script>


</body>

</html>
