/* =========================
   CONFIGURACIÓN GENERAL
========================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;

    background: #f4f6f5;

    color: #26383a;

    transition: 0.3s;
}

button {
    font-family: inherit;
}


/* =========================
   BARRA SUPERIOR
========================= */

header {
    height: 68px;

    background: #234b4d;

    color: white;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 30px;
}


/* LOGO */

.logo {
    display: flex;

    align-items: center;

    gap: 12px;
}

.logo-icon {
    width: 40px;
    height: 40px;

    background: #dce9e3;

    color: #234b4d;

    border-radius: 8px;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 20px;
}

.logo h2 {
    font-size: 19px;

    font-weight: 600;
}


/* =========================
   BOTONES DEL HEADER
========================= */

.header-buttons {
    display: flex;

    gap: 5px;
}

.header-button {
    width: 40px;
    height: 40px;

    border: none;

    border-radius: 7px;

    background: transparent;

    color: white;

    font-size: 18px;

    cursor: pointer;
}

.header-button:hover {
    background: #315d5f;
}


/* =========================
   CONTENIDO
========================= */

main {
    max-width: 1200px;

    margin: auto;

    padding: 35px 25px;
}


/* BIENVENIDA */

.bienvenida {
    margin-bottom: 25px;
}

.bienvenida h1 {
    color: #234b4d;

    font-size: 28px;

    margin-bottom: 7px;
}

.bienvenida p {
    color: #718080;

    font-size: 14px;
}


/* =========================
   MENÚ PRINCIPAL
========================= */

.menu {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 14px;

    margin-bottom: 22px;
}

.menu-button {
    background: white;

    border: 1px solid #dfe6e3;

    border-radius: 9px;

    padding: 18px;

    text-align: left;

    cursor: pointer;

    transition: 0.2s;
}

.menu-button:hover {
    border-color: #94b5a7;

    transform: translateY(-2px);
}


/* ICONOS */

.menu-icon {
    width: 38px;
    height: 38px;

    background: #e4eee9;

    border-radius: 8px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 12px;

    font-size: 18px;
}


/* TEXTO BOTONES */

.menu-button h3 {
    color: #294e50;

    font-size: 15px;

    margin-bottom: 5px;
}

.menu-button p {
    color: #7a8785;

    font-size: 12px;
}


/* =========================
   CONTENIDO PRINCIPAL
========================= */

.contenedor {
    display: grid;

    grid-template-columns: 2fr 1fr;

    gap: 20px;
}


/* TARJETAS */

.tarjeta {
    background: white;

    border: 1px solid #dfe6e3;

    border-radius: 11px;

    padding: 20px;
}

.tarjeta h2 {
    color: #294e50;

    font-size: 19px;

    margin-bottom: 15px;
}


/* =========================
   MAPA
========================= */

.mapa-superior {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 15px;
}

.mapa-superior h2 {
    margin-bottom: 0;
}


/* BOTÓN GOOGLE MAPS */

.abrir-maps {
    text-decoration: none;

    color: #315f60;

    font-size: 13px;

    border: 1px solid #cbdad4;

    padding: 7px 10px;

    border-radius: 6px;
}

.abrir-maps:hover {
    background: #edf4f1;
}


/* CONTENEDOR DEL MAPA */

.mapa {
    width: 100%;

    height: 400px;

    border-radius: 9px;

    overflow: hidden;

    border: 1px solid #d8dfdc;
}


/* GOOGLE MAPS */

.mapa iframe {
    width: 100%;

    height: 100%;

    border: 0;
}


/* =========================
   INFORMACIÓN
========================= */

.dato {
    padding: 13px 0;

    border-bottom:
        1px solid #e8ecea;
}

.dato:last-child {
    border-bottom: none;
}

.dato strong {
    display: block;

    color: #315657;

    font-size: 14px;

    margin-bottom: 5px;
}

.dato span {
    color: #788583;

    font-size: 13px;

    line-height: 1.5;
}


/* =========================
   PANELES
========================= */

.panel {
    position: fixed;

    top: 68px;

    right: 25px;

    width: 290px;

    background: white;

    border: 1px solid #dce3e0;

    border-radius: 9px;

    box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.12);

    padding: 20px;

    display: none;

    z-index: 100;
}


/* PANEL VISIBLE */

.panel.mostrar {
    display: block;
}


/* TÍTULO */

.panel h3 {
    color: #294e50;

    margin-bottom: 15px;
}


/* OPCIONES */

.panel-opcion {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 12px 0;

    border-bottom:
        1px solid #edf0ef;

    font-size: 14px;
}

.panel-opcion:last-child {
    border-bottom: none;
}


/* =========================
   SWITCH
========================= */

.switch {
    width: 40px;

    height: 21px;

    background: #cbd5d1;

    border-radius: 20px;

    cursor: pointer;

    position: relative;
}


/* CÍRCULO DEL SWITCH */

.switch::after {
    content: "";

    position: absolute;

    width: 17px;

    height: 17px;

    top: 2px;

    left: 2px;

    background: white;

    border-radius: 50%;

    transition: 0.2s;
}


/* SWITCH ACTIVO */

.switch.activo {
    background: #4f7d70;
}

.switch.activo::after {
    left: 21px;
}


/* =========================
   NOTIFICACIONES
========================= */

.notificacion {
    background: #f1f5f3;

    padding: 11px;

    border-radius: 7px;

    margin-bottom: 8px;

    font-size: 13px;

    color: #526260;
}


/* =========================
   FOOTER
========================= */

footer {
    text-align: center;

    padding: 25px;

    color: #87928f;

    font-size: 12px;
}


/* =========================
   MODO OSCURO
========================= */

body.oscuro {
    background: #202b2c;

    color: #eeeeee;
}


/* TARJETAS */

body.oscuro .tarjeta,
body.oscuro .menu-button,
body.oscuro .panel {

    background: #2c393a;

    border-color: #415050;
}


/* TÍTULOS */

body.oscuro .bienvenida h1,
body.oscuro .tarjeta h2,
body.oscuro .menu-button h3,
body.oscuro .dato strong,
body.oscuro .panel h3 {

    color: #dce9e3;
}


/* TEXTOS */

body.oscuro .bienvenida p,
body.oscuro .menu-button p,
body.oscuro .dato span {

    color: #b5c0be;
}


/* ICONOS */

body.oscuro .menu-icon {
    background: #3b4b4b;
}


/* NOTIFICACIONES */

body.oscuro .notificacion {

    background: #354344;

    color: #c9d3d0;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 850px) {

    .menu {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .contenedor {
        grid-template-columns: 1fr;
    }

}


/* =========================
   CELULARES
========================= */

@media (max-width: 500px) {

    header {
        padding: 0 15px;
    }

    .logo h2 {
        font-size: 16px;
    }

    main {
        padding: 25px 15px;
    }

    .menu {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .menu-button {
        padding: 14px;
    }

    .menu-button p {
        display: none;
    }

    .mapa {
        height: 350px;
    }

    .panel {
        left: 15px;

        right: 15px;

        width: auto;
    }

}
